__pycache__/
*.py[cod]
.venv/

# exeビルドの作業ディレクトリと成果物。
# build\app_icon.ico や dist\OfficePdfConverter.exe などのバイナリを含むため、
# バイナリファイルを扱えない環境で差分表示が失敗しないよう追跡対象から外す。
/.venv-build/
/build/
/dist/

# tools/make_manual.py が生成するマニュアルのPDF。
# 本文は docs/install_manual.md にテキストで管理する。
/docs/*.pdf

# 利用者が差し替えたアイコン（同梱のBase64版が既定として使われる）
/assets/app_icon.png
